static func glyph(value: String, x: float, baseline: float, size: float, color: String) -> String:
	var scale := size / UNITS
	var width := 0.0
	for character in value: width += float(GLYPHS[character].advance) * scale
	var result := '<g transform="translate(%s %s) scale(%s -%s)" fill="%s">' % [x - width/2, baseline, scale, scale, color]
	var offset := 0.0
	for character in value:
		result += '<path transform="translate(%s 0)" d="%s"/>' % [offset, GLYPHS[character].path]
		offset += float(GLYPHS[character].advance)
	return result + '</g>'

static func texture(rank: String, suit: String) -> ImageTexture:
	var red := suit in ["hearts", "diamonds"]
	var ink := "#ad1530" if red else "#111820"
	var symbol: String = {"spades":"♠", "hearts":"♥", "diamonds":"♦", "clubs":"♣"}.get(suit,"♠")
	var svg := '<svg xmlns="http://www.w3.org/2000/svg" width="768" height="1075" viewBox="0 0 300 420"><rect x="2" y="2" width="296" height="416" rx="15" fill="#fffdf7" stroke="#c9c7be" stroke-width="1.1"/>'
	var index := glyph(rank, 36, 64, 58 if rank != "10" else 47, ink) + glyph(symbol, 36, 101, 32, ink)
	svg += index + '<g transform="translate(300 420) rotate(180)">' + index + '</g>'
	if rank == "A": svg += glyph(symbol, 150, 248, 114, ink)
	elif rank in ["J", "Q", "K"]:
		svg += '<rect x="65" y="39" width="170" height="342" rx="3" fill="#f4ecd8" stroke="%s" stroke-width="2"/>' % ink
		var portrait := '<path d="M79 191 L94 153 126 139 174 139 206 153 221 191 221 210 79 210Z" fill="%s"/><path d="M101 148 126 139 150 188 174 139 199 148 180 210 120 210Z" fill="#c8a254"/><path d="M125 113 175 113 171 148 150 165 129 148Z" fill="#edc9a4" stroke="#40372e" stroke-width="1.5"/><path d="M124 109 126 85 174 85 177 111 164 102 129 113Z" fill="#35312b"/><path d="M122 89 117 67 137 77 150 57 163 77 183 67 178 89Z" fill="#c8a254" stroke="#574325" stroke-width="2"/><path d="M129 118h10m22 0h10m-21 4-4 13 8 1m-14 8h20" fill="none" stroke="#44352b" stroke-width="2"/><path d="M87 177 113 190m74 0 26-13M141 185l9 12 9-12" fill="none" stroke="#fff9dc" stroke-width="3"/>' % ink
		if rank == "K": portrait += '<path d="M131 136 137 151 150 159 163 151 169 136 160 141 150 146 140 141Z" fill="#514131"/>'
		if rank == "Q": portrait += '<path d="M123 94 114 141 126 152 130 105M177 94l9 47-12 11-4-47" fill="#b58b42"/><circle cx="150" cy="149" r="3" fill="#ad1530"/>'
		if rank == "J": portrait += '<path d="M119 83 130 66 172 69 181 86Z" fill="%s"/><path d="M175 72q28-35 27-12l-21 24" fill="#c8a254"/>' % ink
		svg += portrait + '<g transform="translate(300 420) rotate(180)">' + portrait + '</g>'
		svg += glyph(symbol, 150, 225, 38, ink)
	else:
		var count := int(rank)
		var points: Array[Vector2] = []
		if count in [2,3]:
			points = [Vector2(150,107), Vector2(150,313)]
			if count == 3: points.append(Vector2(150,210))
		elif count in [4,5]:
			points = [Vector2(100,107),Vector2(200,107),Vector2(100,313),Vector2(200,313)]
			if count == 5: points.append(Vector2(150,210))
		elif count in [6,7,8]:
			for y in [107,210,313]:
				for x in [100,200]: points.append(Vector2(x,y))
			if count >= 7: points.append(Vector2(150,158))
			if count == 8: points.append(Vector2(150,262))
		else:
			for y in [94,171,249,326]:
				for x in [100,200]: points.append(Vector2(x,y))
			if count == 9: points.append(Vector2(150,210))
			else: points.append_array([Vector2(150,133),Vector2(150,287)])
		for point in points:
			if point.y > 210: svg += '<g transform="translate(300 420) rotate(180)">' + glyph(symbol, 300-point.x, 420-point.y+16, 49, ink) + '</g>'
			else: svg += glyph(symbol, point.x, point.y+16, 49, ink)
	svg += '</svg>'
	var image := Image.new()
	var error := image.load_svg_from_string(svg)
	assert(error == OK, "Card vector face must render")
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)
