static func line(value: String, x: float, baseline: float, size: float, color := "#cab789") -> String:
	var scale := size/UNITS
	var width := 0.0
	for character in value: width += float(GLYPHS[character].advance)*scale
	var svg := '<g fill="%s" transform="translate(%s %s) scale(%s -%s)">' % [color,x-width/2,baseline,scale,scale]
	var offset := 0.0
	for character in value:
		svg += '<path transform="translate(%s 0)" d="%s"/>' % [offset,GLYPHS[character].path]
		offset += float(GLYPHS[character].advance)
	return svg+'</g>'

static func image_texture(svg: String) -> ImageTexture:
	var image := Image.new()
	var error := image.load_svg_from_string(svg)
	if error != OK:
		push_error("Casino identity SVG could not be rendered")
		return null
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)

static func logo() -> ImageTexture:
	var svg := '<svg xmlns="http://www.w3.org/2000/svg" width="1400" height="1260" viewBox="0 0 1000 900"><defs><linearGradient id="gold" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff0b2"/><stop offset=".3" stop-color="#b88d45"/><stop offset=".55" stop-color="#f5d68c"/><stop offset="1" stop-color="#99743b"/></linearGradient></defs>'
	# A spade seal, engraved monogram, double shield and paired laurel branches.
	svg += '<path d="M500 65 687 145 679 334Q661 468 500 525 339 468 321 334L313 145Z" fill="#12251b" stroke="url(#gold)" stroke-width="5"/><path d="M500 84 669 157 660 331Q644 448 500 503 356 448 340 331L331 157Z" fill="none" stroke="#b89858" stroke-width="1.5"/>'
	for side in [-1,1]:
		for index in range(11):
			var angle := deg_to_rad(18+index*12.0)
			var x: float = 500 + side*sin(angle)*265
			var y := 264 - cos(angle)*230
			svg += '<ellipse cx="%s" cy="%s" rx="11" ry="29" transform="rotate(%s %s %s)" fill="url(#gold)"/>' % [x,y,-side*(30+index*12),x,y]
		svg += '<path d="M%s 50Q%s 273 %s 508" fill="none" stroke="#b89858" stroke-width="2"/>' % [500+side*105,500+side*365,500+side*90]
	svg += '<path d="M500 137C470 190 401 208 397 267 394 329 461 349 487 308 482 347 470 370 443 389H557C530 370 518 347 513 308 539 349 606 329 603 267 599 208 530 190 500 137Z" fill="url(#gold)"/>'
	svg += line("21",500,292,103,"#152219")
	svg += '<path d="M250 550H415L438 565 500 535 562 565 585 550H750M105 627H227M773 627H895" fill="none" stroke="#c3a362" stroke-width="2"/><path d="m500 552 9 13-9 13-9-13Z" fill="#c3a362"/>'
	svg += line("LA TABLE 21",500,679,108,"url(#gold)")
	svg += line("BLACKJACK EUROPÉEN",500,739,29,"#d7bf85")
	svg += '<path d="M305 778H457L500 794 543 778H695" fill="none" stroke="#c3a362" stroke-width="1.5"/></svg>'
	return image_texture(svg)

static func table_line(value: String, x: float, baseline: float, size: float) -> String:
	# Compensate for the shallow seated viewing angle, like elongated casino felt lettering.
	return '<g transform="translate(0 %s) scale(1 2.1)">' % baseline + line(value,x,0,size) + '</g>'

static func felt() -> ImageTexture:
	var svg := '<svg xmlns="http://www.w3.org/2000/svg" width="3000" height="2000" viewBox="0 0 1500 1000">'
	svg += '<path d="M594 346H680L707 333 750 346 793 333 820 346H906" fill="none" stroke="#b8a87f" stroke-width="1.1"/>'
	svg += table_line("LA TABLE 21",750,394,43)
	svg += table_line("BLACKJACK EUROPÉEN",750,426,20)
	var text := "BLACKJACK PAIE 3 POUR 2"
	for index in text.length():
		if text[index] == " ": continue
		var angle := deg_to_rad(lerpf(-54,54,float(index)/(text.length()-1)))
		var x := 750+sin(angle)*395
		var y := 520+395*(1-cos(angle))
		svg += '<g transform="translate(%s %s) rotate(%s)">' % [x,y,rad_to_deg(angle)] + table_line(text[index],0,0,48) + '</g>'
	svg += table_line("LE CROUPIER RESTE À 17",750,607,24)
	svg += '<path d="M525 627H687m126 0h162m-225-8 8 8-8 8-8-8Z" fill="none" stroke="#b8a87f" stroke-width="1.1"/>'
	svg += '<rect x="1130" y="390" width="188" height="106" rx="7" fill="none" stroke="#b8a87f" stroke-width="1.1"/>'
	svg += table_line("MISES",1224,418,20)+table_line("MIN 100",1224,450,23)+table_line("MAX 500",1224,481,23)
	svg += '</svg>'
	return image_texture(svg)
